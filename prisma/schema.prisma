generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id              String     @id @default(cuid())
  shopDomain      String     @unique
  customDomain    String?
  storeName       String
  storefrontToken String     @default("tokenless")
  logoUrl         String?
  description     String?
  currency        String     @default("USD")
  primaryColor    String?
  active          Boolean    @default(true)
  featured        Boolean    @default(false)
  productCount    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  products        Product[]
  webhooks        Webhook[]
  syncLogs        SyncLog[]
  orders          Order[]
}

model Product {
  id           String   @id
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title        String
  handle       String
  description  String?
  price        Float
  comparePrice Float?
  currency     String   @default("USD")
  imageUrl     String?
  images       String[]
  productUrl   String
  tags         String[]
  category     String?
  vendor       String?
  available    Boolean  @default(true)
  syncedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([available])
}

model Order {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  productTitle    String
  productUrl      String
  productImageUrl String?
  productPrice    Float
  currency        String         @default("USD")
  quantity        Int            @default(1)
  notes           String?
  status          String         @default("pending")
  deliveryStatus  String         @default("unassigned")
  deliveryAddress String?
  deliveryCity    String?
  deliveryRegion  String?
  driverName      String?
  driverPhone     String?
  estimatedAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  notifications   Notification[]

  @@index([storeId])
  @@index([status])
  @@index([deliveryStatus])
}

model Notification {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

model Webhook {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  topic     String
  shopifyId String?
  createdAt DateTime @default(now())

  @@index([storeId])
}

model SyncLog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status    String
  message   String?
  products  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([storeId])
}
